// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partners     Partner[]
  transactions Transaction[]
  ledgerNotes  LedgerNote[]
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  transactions Transaction[]
  ledgers      Ledger[]

  @@unique([ownerId, name])
}

model Ledger {
  id    String @id @default(cuid())
  title String // 自由記述（例: "通常", "5000円貸しパターン"）

  // 週利率(%)。残高帯によって2段階で指定できる。0 = 無利子
  weeklyInterestRateUnder5000 Decimal? @default(0) @db.Decimal(5, 2) // 残高5000円未満に適用
  weeklyInterestRateFrom5000  Decimal? @default(0) @db.Decimal(5, 2) // 残高5000円以上に適用

  shareToken          String?   @unique
  shareTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  notes        LedgerNote[]

  @@index([partnerId])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Int // +は貸し、-は借り
  description String? // 100文字以内
  date        DateTime // UTCで保存、クライアント側でJST変換
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  // 口座（Ledger）への紐づけ。既存データの移行が済むまでは null を許容する。
  ledgerId String?
  ledger   Ledger? @relation(fields: [ledgerId], references: [id])

  @@index([ownerId])
  @@index([partnerId])
  @@index([ledgerId])
  @@index([date])
}

model LedgerNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  ledgerId String
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
  @@index([ownerId])
}
