// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 取引フォームの金額ボタンに出す名目ラベルのプリセット。
  // "BOTH" | "LENDER" | "BORROWER"（src/lib/transaction-labels.ts）
  transactionLabelPreset String @default("BOTH")

  partners     Partner[]
  transactions Transaction[]
  ledgerNotes  LedgerNote[]
}

model Partner {
  id         String   @id @default(cuid())
  name       String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 相手ごとの公開ページ（/share/[token]）用のトークン。
  // 以前は口座（Ledger）ごとに持っていたが、公開は相手単位に一本化した。
  shareToken          String?   @unique
  shareTokenExpiresAt DateTime?

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  transactions Transaction[]
  ledgers      Ledger[]

  @@unique([ownerId, name])
}

model Ledger {
  id    String @id @default(cuid())
  title String // 自由記述（例: "通常", "5000円貸しパターン"）

  // 年利(%)。0 = 無利子。週ごとの利息額は「年利 ÷ 52」で計算する
  annualInterestRate Decimal? @default(0) @db.Decimal(6, 2)

  // 利息が発生する曜日（JST基準。0=日曜 〜 6=土曜）
  interestAccrualWeekday Int @default(3)

  // true = 複利（元本＋未払利息に課金） / false = 単利（元本のみに課金）
  interestCompounding Boolean @default(false)

  // 同じ日に二重で利息を発生させないための最終発生日時
  lastInterestAccruedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  notes        LedgerNote[]

  @@index([partnerId])
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Int // +は貸し、-は借り
  purpose     String? // 用途（例: 麻雀、ランチ、返済）。1行・100文字以内
  description String? // メモ（詳細テキスト）。複数行可・1000文字以内
  date        DateTime // UTCで保存、クライアント側でJST変換

  // 取引の種別。"NORMAL"（通常の貸し借り・返済） | "INTEREST"（自動発生した利息）
  // src/lib/transaction-kind.ts を参照
  kind String @default("NORMAL")

  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  // 口座（Ledger）への紐づけ。既存データの移行が済むまでは null を許容する。
  ledgerId String?
  ledger   Ledger? @relation(fields: [ledgerId], references: [id])

  @@index([ownerId])
  @@index([partnerId])
  @@index([ledgerId])
  @@index([date])
}

model LedgerNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   Account @relation(fields: [ownerId], references: [id])

  ledgerId String
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
  @@index([ownerId])
}

// 管理画面（/admin）で行った操作の記録。
// 管理画面は Cloudflare Access で認証するため、actorEmail は Account ではなく
// Access が認証したメールアドレスをそのまま文字列で持つ（リレーションは張らない）。
model AdminAuditLog {
  id String @id @default(cuid())

  // 操作した管理者のメールアドレス（Cloudflare Access の identity）
  actorEmail String

  // 操作の種別。src/lib/admin-audit.ts の ADMIN_AUDIT_ACTIONS
  action String

  // 操作対象の種類（"Partner" / "Job" など）と識別子
  targetType String?
  targetId   String?

  // 人が読むための要約（例: "共有リンクを失効: たろう"）
  summary String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
}
