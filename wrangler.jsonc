{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers へのデプロイ設定（OpenNext）。詳細は docs/11-cloudflare-workers.md
  "name": "tukekan",
  // OpenNext の生成物（.open-next/worker.js）を包み、Cron Triggers 用の scheduled を足したエントリ
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext が内部で使う自分自身へのサービスバインディング（name と一致させる）
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tukekan"
    }
  ],
  // 本番はカスタムドメイン（tukekan.paritto.dev・ダッシュボードで設定）だけで公開する。
  // *.workers.dev とプレビューURLは Cloudflare Access を通らない入り口になるので閉じる。
  "workers_dev": false,
  "preview_urls": false,
  // Cron Triggers（UTC）。worker.ts の SCHEDULED_ROUTES と一致させる
  "triggers": {
    // 毎日 00:00 JST: 週次自動利子ジョブ
    "crons": ["0 15 * * *"]
  },
  // DB（Cloudflare D1）。アプリからは env.DB として使う（src/lib/db.ts）。
  // マイグレーションは drizzle-kit が drizzle/ に生成し、wrangler が適用する（docs/11-cloudflare-workers.md）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tukekan-db",
      "database_id": "05e9f098-7563-4df4-b455-54ec05e9196f",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
  // JWT_SECRET・CF_ACCESS_* などは
  // `wrangler secret put` かダッシュボードの「変数とシークレット」で設定する（ここには書かない）。
}
