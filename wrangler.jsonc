{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers へのデプロイ設定（OpenNext）。詳細は docs/11-cloudflare-workers.md
  "name": "tukekan",
  // OpenNext の生成物（.open-next/worker.js）を包み、Cron Triggers 用の scheduled を足したエントリ
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // OpenNext が内部で使う自分自身へのサービスバインディング（name と一致させる）
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tukekan"
    }
  ],
  // 本番はカスタムドメイン（tukekan.paritto.dev・ダッシュボードで設定）だけで公開する。
  // *.workers.dev とプレビューURLは Cloudflare Access を通らない入り口になるので閉じる。
  "workers_dev": false,
  "preview_urls": false,
  // Cron Triggers（UTC）。worker.ts の SCHEDULED_ROUTES と一致させる
  "triggers": {
    // 毎日 00:00 JST: 週次自動利子ジョブ
    "crons": ["0 15 * * *"]
  },
  "observability": {
    "enabled": true
  }
  // DB 接続（DATABASE_URL）・JWT_SECRET・CF_ACCESS_* などは
  // `wrangler secret put` かダッシュボードの「変数とシークレット」で設定する（ここには書かない）。
  //
  // Hyperdrive を使う場合は次を追加する（src/lib/prisma.ts が自動で優先して使う）:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<Hyperdrive の ID>" }]
}
